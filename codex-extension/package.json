{
  "name": "codex-remote-extension",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.2.0",
  "publisher": "jaloveeye",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaloveeye/codex-remote.git"
  },
  "homepage": "https://www.jaloveeye.com/",
  "bugs": {
    "url": "https://github.com/jaloveeye/codex-remote/issues"
  },
  "icon": "icon.png",
  "keywords": [
    "codex",
    "remote",
    "mobile",
    "websocket",
    "relay",
    "session",
    "agent"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexRemote.start",
        "title": "%command.start%"
      },
      {
        "command": "codexRemote.stop",
        "title": "%command.stop%"
      },
      {
        "command": "codexRemote.toggle",
        "title": "%command.toggle%"
      },
      {
        "command": "codexRemote.showConnections",
        "title": "%command.showConnections%"
      },
      {
        "command": "codexRemote.statusBarClick",
        "title": "%command.statusBarClick%"
      },
      {
        "command": "codexRemote.checkRelayServer",
        "title": "%command.checkRelayServer%"
      },
      {
        "command": "codexRemote.disconnectRelay",
        "title": "%command.disconnectRelay%"
      },
      {
        "command": "codexRemote.connectToRelaySessionById",
        "title": "%command.connectSessionById%"
      },
      {
        "command": "codexRemote.setRelaySessionId",
        "title": "%command.setRelaySessionId%"
      }
    ],
    "configuration": {
      "title": "%extension.configurationTitle%",
      "properties": {
        "codexRemote.relayServerUrl": {
          "type": "string",
          "scope": "application",
          "default": "https://relay.example.com",
          "description": "%config.relayServerUrl.description%"
        },
        "codexRemote.iosAppStoreUrl": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "%config.iosStoreUrl.description%"
        },
        "codexRemote.androidPlayStoreUrl": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "%config.androidStoreUrl.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ws": "^8.19.0"
  },
  "galleryBanner": {
    "color": "#1f6f43",
    "theme": "dark"
  }
}
